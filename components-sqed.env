# shellcheck shell=sh
# Component manifest for the SLURM (Sqed) variant: sourced by
# install.d/components-slurm.sh when --with-slurm is given, after components.env.
# Same conventions as components.env, whose gateway, quantum-api and dashboard
# the variant uses unchanged: Sqed is configuration of those components
# (SITE_PLUGIN=sqed, AUTH_PLUGINS, USERNAME_FORMAT, JOB_PORTAL_ONLY), set by the
# install.d hooks. This file only adds the two components the default deploy
# does not have.

# The SLURM prolog/epilog that mint per-job QPU tokens.
PROLOG_EPILOG_REPO=${PROLOG_EPILOG_REPO:-${GIT_BASE}/Lagrange-prolog-epilog.git}
PROLOG_EPILOG_REF=${PROLOG_EPILOG_REF:-2026.11.0}

# The containerised SLURM cluster the variant runs jobs on: LINKS Foundation's
# fork of exactlab/vhpc (Slurm 23.11.10, remote licenses, plugin mounts). Public,
# so no token is needed, and none is sent: GITLAB_TOKEN goes to the GitLab host
# only.
SLURM_REPO=${SLURM_REPO:-https://github.com/LINKS-Foundation-CPE/vhpc.git}
SLURM_REF=${SLURM_REF:-e43a01d5a4f9ef3aecea7c3ab3c5b7244825b18c}
