# shellcheck shell=sh
# Component manifest — sourced by install.sh.
#
# Each component has a REPO (where to clone from) and a REF (what to check
# out: a release tag, a commit SHA, or a branch name for a floating dev setup).
#
# Override GIT_BASE — or any individual *_REPO / *_REF — at install time to
# clone from somewhere else (a fork, a mirror) or another version:
#   QUANTUM_API_REF=main ./install.sh ...

GIT_BASE=${GIT_BASE:-https://github.com/LINKS-Foundation-CPE}

NGINX_REVERSE_PROXY_REPO=${NGINX_REVERSE_PROXY_REPO:-${GIT_BASE}/QC-Gateway.git}
NGINX_REVERSE_PROXY_REF=${NGINX_REVERSE_PROXY_REF:-2026.10.0}

QUANTUM_API_REPO=${QUANTUM_API_REPO:-${GIT_BASE}/Lagrange-API.git}
QUANTUM_API_REF=${QUANTUM_API_REF:-2026.10.0}

QUANTUM_DASHBOARD_REPO=${QUANTUM_DASHBOARD_REPO:-${GIT_BASE}/Lagrange-Dashboard.git}
QUANTUM_DASHBOARD_REF=${QUANTUM_DASHBOARD_REF:-2026.10.0}
